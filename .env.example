# Django runtime
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# Google Cloud Speech-to-Text
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_STT_API_KEY=replace-with-a-google-stt-api-key
GOOGLE_STT_LOCATION=us
GOOGLE_STT_MODEL=chirp_3

# Real Gmail SMTP delivery (STARTTLS on port 587)
# For automated tests or development without delivery, set:
# EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-gmail-address@example.com
EMAIL_HOST_PASSWORD=replace-with-a-new-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail-address@example.com
EMAIL_TIMEOUT=15

# Recipient used only for an intentional harmless SMTP smoke test.
EMAIL_TEST_RECIPIENT=recipient-you-control@example.com
